# Copy this file to `.env` (same folder) and fill in your Firebase web config.
# Firebase console → Project settings → General → Your apps → SDK setup and configuration.
# `.env` is gitignored. In GitHub Actions, add each value as a repository secret
# with the same name (Settings → Secrets and variables → Actions).
#
# Without these, the site still builds: analytics is skipped and the contact
# form falls back to opening the visitor's email app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
