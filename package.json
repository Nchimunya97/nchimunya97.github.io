{
  "name": "nchimunya-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio of Nchimunya Sikanyiti — Turborepo monorepo",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
